            "else if",
            "else",
            "then",
            "elseif"
          ],
          "correctOption": 1,
          "blocks": [],
          "correctOrder": [],
          "explanation": "O `else` executa quando a condição do `if` é falsa."
        },
        {
          "id": "l1e1",
          "kind": "gap",
          "prompt": "Operador de igualdade em Dart:",
          "template": "if (a ___ b) { print(\"Iguais\"); }",
