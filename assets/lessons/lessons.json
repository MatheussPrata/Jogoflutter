    {
      "index": 1,
      "title": "Controle de Fluxo (if/else)",
      "concept": "Tome decisões no código com condicionais",
      "exercises": [
        {
          "id": "l1e0",
          "kind": "gap",
          "prompt": "Complete a estrutura if:",
          "template": "if (idade >= 18) {\n  print(\"Maior\");\n} ___ {\n  print(\"Menor\");\n}",
